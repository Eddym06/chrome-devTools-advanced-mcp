{
  "name": "chrome-devtools-advanced-mcp",
  "version": "1.7.2",
  "description": "Cross-platform Chrome MCP that runs on a persistent clone of your real Chrome profile (session/logins carried over) with real-time request interception, response modification, network capture, HAR recording/replay, accessibility testing, stealth mode, console log capture, performance audits, and 95+ tools plus MCP resources and prompts. Includes smart workflows for common tasks. Works on Windows, Mac, and Linux.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "bin": {
    "chrome-devtools-advanced-mcp": "dist/index.js"
  },
  "type": "module",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc",
    "dev": "tsc --watch",
    "prepare": "npm run build",
    "start": "node dist/index.js",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "vitest run",
    "docs:check": "node scripts/validate-docs.mjs",
    "pack:check": "npm run build && npm pack --dry-run"
  },
  "keywords": [
    "mcp",
    "chrome",
    "devtools",
    "automation",
    "cdp",
    "service-worker",
    "anti-detection",
    "model-context-protocol",
    "cross-platform",
    "windows",
    "mac",
    "linux",
    "playwright",
    "browser-automation"
  ],
  "author": "Eddy M",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "chrome-remote-interface": "^0.33.2",
    "playwright": "^1.62.1",
    "playwright-core": "^1.62.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@typescript-eslint/eslint-plugin": "^8.19.1",
    "@typescript-eslint/parser": "^8.19.1",
    "eslint": "^9.18.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "vitest": "^3.0.5"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Eddym06/chrome-devTools-advanced-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/Eddym06/chrome-devTools-advanced-mcp/issues"
  }
}
